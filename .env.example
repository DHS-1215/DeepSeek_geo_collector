DEEPSEEK_URL=https://chat.deepseek.com

BROWSER_PROFILE_DIR=browser_profile
OUTPUT_DIR=output

HEADLESS=false

DEFAULT_TIMEOUT_SECONDS=30

QUICK_MAX_WAIT_SECONDS=180
EXPERT_MAX_WAIT_SECONDS=360

NETWORK_RETRY_TIMES=2
NETWORK_RETRY_INTERVAL_SECONDS=3
TASK_INTERVAL_SECONDS=3

SAVE_RAW_HTML_ON_ERROR=true

LOG_LEVEL=INFO

CHROMIUM_EXECUTABLE_PATH=D:\playwright_browsers\chrome-win64\chrome.exe

# Sentiment Analysis
SENTIMENT_PROVIDER=ollama
SENTIMENT_MODEL=qwen2.5:7b
SENTIMENT_BASE_URL=http://127.0.0.1:11434

SENTIMENT_PROMPT_VERSION=sentiment_v7
SENTIMENT_RULE_VERSION=sentiment_rules_v5
SENTIMENT_MODEL_CONFIG_VERSION=sentiment_model_config_v1

SENTIMENT_REQUEST_TIMEOUT_SECONDS=180
SENTIMENT_TEMPERATURE=0
SENTIMENT_MAX_TOKENS=256

SENTIMENT_MAX_RETRIES=2
SENTIMENT_RETRY_BACKOFF_SECONDS=3,8
SENTIMENT_MAX_CONCURRENCY=1

SENTIMENT_EVIDENCE_MAX_ITEMS=3
SENTIMENT_CONTEXT_SENTENCES_BEFORE=2
SENTIMENT_CONTEXT_SENTENCES_AFTER=2
SENTIMENT_NEGATIVE_PRIORITY=true